@model SocialReview.Models.Company
@{
    ViewData["Title"] = "Chi tiết Doanh nghiệp";
    Layout = "_AdminLayout";
}

<div class="admin-container">
    <div class="admin-header">
        <a href="@Url.Action("Index", "Company", new { area = "Admin" })" class="btn btn-secondary" style="margin-bottom: 1rem;">
            <i class="fa-solid fa-arrow-left"></i> Quay lại
        </a>
        <h1 class="admin-title">@Model.CompanyName</h1>
        <p class="admin-subtitle">Mã định danh: #@Model.CompanyID</p>
    </div>

    <div class="form-container">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem;">
            <div>
                <h3 style="margin-top: 0; color: var(--primary-purple); border-bottom: 2px solid #f3f4f6; padding-bottom: 0.5rem;">Thông tin liên hệ</h3>
                <div class="form-group mt-3">
                    <span class="form-label">Lĩnh vực hoạt động</span>
                    <span class="badge badge-purple">@Model.Industry</span>
                </div>
                <div class="form-group">
                    <span class="form-label">Email hỗ trợ</span>
                    <div style="font-weight: 500;">@Model.ContactEmail</div>
                </div>
                <div class="form-group">
                    <span class="form-label">Hotline</span>
                    <div style="font-weight: 500;">@Model.Phone</div>
                </div>
            </div>

            <div>
                <h3 style="margin-top: 0; color: var(--primary-purple); border-bottom: 2px solid #f3f4f6; padding-bottom: 0.5rem;">Giới thiệu</h3>
                <div class="form-group mt-3">
                    <p style="color: #374151; line-height: 1.6; background: #f9fafb; padding: 1rem; border-radius: 0.5rem; border: 1px solid #e5e7eb;">
                        @(string.IsNullOrEmpty(Model.CompanyDescription) ? "Chưa có mô tả về doanh nghiệp này." : Model.CompanyDescription)
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
