@model IEnumerable<SocialReview.Models.User>
@{
    ViewData["Title"] = "Danh sách người dùng";
    Layout = "_AdminLayout";
}

<div class="admin-container">
    <div class="page-section-header">
        <h3 class="page-section-title">Danh sách người dùng</h3>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success"><i class="fa-solid fa-check-circle"></i> @TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger"><i class="fa-solid fa-exclamation-circle"></i> @TempData["ErrorMessage"]</div>
    }

    <div class="table-container">
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Vai trò</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        @if (item.UserRole != "Admin")
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.UserName</td>
                                <td>@item.Email</td>
                                <td>
                                    @if (item.UserRole == "Business")
                                    {
                                        <span class="badge badge-purple">Doanh nghiệp</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-blue">Cá nhân</span>
                                    }
                                </td>
                                <td>
                                    <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                                        <a href="@Url.Action("Edit", "User", new { area = "Admin", id = item.Id })" class="btn btn-yellow" title="Sửa">
                                            <i class="fa-solid fa-pencil"></i>
                                        </a>

                                        <a href="@Url.Action("Details", "User", new { area = "Admin", id = item.Id })" class="btn btn-blue" title="Xem">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>

                                        <a href="@Url.Action("Delete", "User", new { area = "Admin", id = item.Id })" class="btn btn-red" title="Xóa" onclick="return confirm('Xóa tài khoản này?');">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="mobile-cards">
            @foreach (var item in Model)
            {
                @if (item.UserRole != "Admin")
                {
                    <div class="mobile-card">
                        <div class="mobile-card-header">
                            <div class="mobile-card-title">@item.UserName</div>
                            <div class="mobile-card-id">#@item.Id</div>
                        </div>
                        <div class="mobile-card-body">
                            <div class="mobile-card-row">
                                <div class="mobile-card-label">Email</div>
                                <div class="mobile-card-value">@item.Email</div>
                            </div>
                            <div class="mobile-card-row">
                                <div class="mobile-card-label">Vai trò</div>
                                <div class="mobile-card-value">@(item.UserRole == "Business" ? "Doanh nghiệp" : "Cá nhân")</div>
                            </div>
                        </div>
                        <div class="mobile-card-actions">
                            <a href="@Url.Action("Edit", "User", new { area = "Admin", id = item.Id })" class="btn btn-yellow">
                                <i class="fa-solid fa-pencil"></i> Sửa
                            </a>

                            <a href="@Url.Action("Details", "User", new { area = "Admin", id = item.Id })" class="btn btn-blue">
                                <i class="fa-solid fa-eye"></i> Xem
                            </a>

                            <a href="@Url.Action("Delete", "User", new { area = "Admin", id = item.Id })" class="btn btn-red" onclick="return confirm('Xóa?');">
                                <i class="fa-solid fa-trash"></i> Xóa
                            </a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
