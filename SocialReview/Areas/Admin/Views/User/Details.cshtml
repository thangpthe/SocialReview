@model SocialReview.Models.User
@{
    ViewData["Title"] = "Chi tiết Người dùng";
    Layout = "_AdminLayout";
}

<div class="admin-container">
    <div class="admin-header">
        <a asp-action="Index" class="btn btn-secondary" style="margin-bottom: 1rem;">
            <i class="fa-solid fa-arrow-left"></i> Quay lại danh sách
        </a>
        <h1 class="admin-title">Hồ sơ Người dùng</h1>
        <p class="admin-subtitle">Chi tiết tài khoản: @Model.UserName</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
        <div class="form-container">
            <div style="text-align: center; margin-bottom: 2rem;">
                <div style="width: 100px; height: 100px; background: var(--primary-purple); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; font-weight: bold; margin: 0 auto 1rem;">
                    @(string.IsNullOrEmpty(Model.FullName) ? Model.UserName.Substring(0, 1).ToUpper() : Model.FullName.Substring(0, 1).ToUpper())
                </div>
                <h2 style="margin: 0; font-size: 1.5rem; color: #111827;">@Model.FullName</h2>
                <p style="margin: 0.25rem 0 0 0; color: #6b7280;">@@@Model.UserName</p>
            </div>

            <div class="form-group" style="border-bottom: 1px solid #f3f4f6; padding-bottom: 1rem;">
                <span class="form-label">Email liên hệ</span>
                <div style="font-weight: 500; color: #111827;">@Model.Email</div>
            </div>
            <div class="form-group" style="border-bottom: 1px solid #f3f4f6; padding-bottom: 1rem;">
                <span class="form-label">Số điện thoại</span>
                <div style="font-weight: 500; color: #111827;">@(string.IsNullOrEmpty(@Model.PhoneNumber) ? "Chưa cập nhật" : Model.PhoneNumber)</div>
            </div>
            <div class="form-group" style="border-bottom: 1px solid #f3f4f6; padding-bottom: 1rem;">
                <span class="form-label">Bảo mật</span>
                <div style="font-weight: 500; color: #16a34a;"><i class="fa-solid fa-shield-check"></i> Mật khẩu đã được mã hóa ẩn</div>
            </div>
        </div>

        <div class="form-container">
            <h3 style="margin-top: 0; margin-bottom: 1.5rem; color: #374151; font-size: 1.1rem;">Thông tin Hệ thống</h3>

            <div class="form-group">
                <span class="form-label">Trạng thái tài khoản</span>
                <div>
                    @(Model.IsActive? Html.Raw("<span class='badge badge-success'>Đang hoạt động</span>") : Html.Raw("<span class='badge badge-danger'>Đã khóa</span>"))
                </div>
            </div>

            <div class="form-group">
                <span class="form-label">Ngày tham gia</span>
                <div style="font-weight: 500; color: #111827;">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
            </div>

            <div class="form-group" style="margin-top: 2rem;">
                <span class="form-label">Hành động kiểm duyệt</span>
                <div style="display: flex; gap: 0.5rem; margin-top: 0.5rem;">
                    @if (Model.IsActive)
                    {
                        <a asp-action="LockUser" asp-route-id="@Model.Id" class="btn btn-red" onclick="return confirm('Khóa tài khoản này?');"><i class="fa-solid fa-lock"></i> Khóa tài khoản</a>
                    }
                    else
                    {
                        <a asp-action="UnlockUser" asp-route-id="@Model.Id" class="btn btn-green"><i class="fa-solid fa-unlock"></i> Mở khóa</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>