@model SocialReview.Models.Product
@{
    ViewData["Title"] = "Cập nhật Sản phẩm";
    Layout = "_AdminLayout";
}

<div class="admin-container">
    <div class="form-container">
        <h1 class="form-title">Cập nhật Sản phẩm / Dịch vụ</h1>
        <p class="form-subtitle">Thông tin sẽ được hiển thị công khai cho người dùng.</p>

        <form asp-action="EditProduct" method="post" enctype="multipart/form-data" id="product-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <!-- Hidden ID -->
            <input type="hidden" asp-for="ProductID" />

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                <!-- Cột trái: Thông tin chính -->
                <div class="lg:col-span-7 space-y-6">
                    <!-- Tên sản phẩm -->
                    <div class="form-group">
                        <label asp-for="ProductName" class="form-label">Tên sản phẩm / Dịch vụ <span class="text-red-500">*</span></label>
                        <input asp-for="ProductName" class="form-control" placeholder="Ví dụ: Khóa học Digital Marketing 2026" />
                        <span asp-validation-for="ProductName" class="field-validation-error"></span>
                    </div>

                    <!-- Mô tả -->
                    <div class="form-group">
                        <label asp-for="ProductDescription" class="form-label">Mô tả chi tiết</label>
                        <textarea asp-for="ProductDescription" class="form-control" rows="6"
                                  placeholder="Mô tả chi tiết sản phẩm..."></textarea>
                        <div class="text-xs text-gray-500 mt-1 text-right">
                            <span id="desc-count">0</span>/2000 ký tự
                        </div>
                        <span asp-validation-for="ProductDescription" class="field-validation-error"></span>
                    </div>

                    <!-- Giá & Loại -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="form-group">
                            <label asp-for="ProductPrice" class="form-label">Giá (VNĐ)</label>
                            <div class="relative">
                                <input asp-for="ProductPrice" class="form-control pl-12" type="number" min="0" step="1000" />
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">₫</span>
                            </div>
                            <span asp-validation-for="ProductPrice" class="field-validation-error"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="ProductType" class="form-label">Loại sản phẩm</label>
                            <input asp-for="ProductType" class="form-control" placeholder="Sản phẩm / Dịch vụ / Khóa học..." />
                            <span asp-validation-for="ProductType" class="field-validation-error"></span>
                        </div>
                    </div>
                </div>

                <!-- Cột phải: Ảnh & Trạng thái -->
                <div class="lg:col-span-5 space-y-6">
                    <!-- Ảnh sản phẩm -->
                    <div class="form-group">
                        <label class="form-label">Hình ảnh sản phẩm</label>

                        <!-- Preview -->
                        <div id="image-preview" class="mb-4 border border-gray-200 rounded-xl overflow-hidden bg-gray-50 aspect-video flex items-center justify-center">
                            @if (!string.IsNullOrEmpty(Model.ProductImage))
                            {
                                <img id="preview-img" src="@Model.ProductImage" alt="Preview" class="max-h-full max-w-full object-contain">
                            }
                            else
                            {
                                <div class="text-center text-gray-400">
                                    <i class="fa-solid fa-image fa-3x"></i>
                                    <p class="mt-2 text-sm">Chưa có ảnh</p>
                                </div>
                            }
                        </div>

                        <!-- Upload file -->
                        <div class="mb-3">
                            <label class="form-label text-sm">Tải ảnh lên</label>
                            <input type="file" id="image-upload" accept="image/*" class="form-control" />
                        </div>

                        <!-- Hoặc nhập URL -->
                        <div>
                            <label asp-for="ProductImage" class="form-label text-sm">Hoặc dán URL ảnh</label>
                            <input asp-for="ProductImage" class="form-control" id="image-url" placeholder="https://..." />
                            <span asp-validation-for="ProductImage" class="field-validation-error"></span>
                        </div>
                    </div>

                    <!-- Trạng thái -->
                    <div class="form-group">
                        <label class="form-label flex items-center gap-2">
                            <span>Trạng thái hiển thị</span>
                            <label class="switch">
                                <input asp-for="Disabled" type="checkbox" id="disabled-toggle" />
                                <span class="slider round"></span>
                            </label>
                            <span id="status-label" class="text-sm font-medium">
                                @(Model.Disabled == true ? "Đã ẩn" : "Đang hiển thị")
                            </span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Nút hành động -->
            <div class="flex flex-col sm:flex-row justify-between items-center gap-4 mt-10 border-t pt-8">
                <a asp-action="Index" class="text-gray-500 hover:text-gray-700 flex items-center gap-2">
                    <i class="fa-solid fa-arrow-left"></i>
                    <span>Quay lại danh sách</span>
                </a>

                <div class="flex gap-3">
                    <button type="button" onclick="window.history.back()"
                            class="btn btn-secondary px-6 py-3">
                        Hủy
                    </button>
                    <button type="submit" class="btn btn-primary px-8 py-3 flex items-center gap-2">
                        <i class="fa-solid fa-save"></i>
                        Lưu thay đổi
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

