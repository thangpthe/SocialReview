@model IEnumerable<SocialReview.Models.Review>
@{
    ViewData["Title"] = "Quản lý Reviews";
    Layout = "_AdminLayout";
}

<div class="admin-container">
    <div class="admin-header">
        <h1 class="admin-title">Quản lý Reviews</h1>
        <p class="admin-subtitle">Xem, kiểm duyệt và quản lý tất cả đánh giá từ người dùng</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="fa-solid fa-check-circle"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            <i class="fa-solid fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="stats-grid" style="margin-bottom: 2rem;">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="fa-solid fa-comments"></i></div>
            <div class="stat-content">
                <p class="stat-label">Tổng số reviews</p>
                <p class="stat-number">@ViewBag.TotalReviews</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon orange"><i class="fa-solid fa-clock-rotate-left"></i></div>
            <div class="stat-content">
                <p class="stat-label">Reviews chờ duyệt</p>
                <p class="stat-number">@ViewBag.PendingReviews</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green"><i class="fa-solid fa-check-double"></i></div>
            <div class="stat-content">
                <p class="stat-label">Đang hiển thị</p>
                <p class="stat-number">@(Model?.Count() ?? 0)</p>
            </div>
        </div>
    </div>

    <div class="filter-bar">
        <span style="font-weight: 600; color: #374151;"><i class="fa-solid fa-filter"></i> Lọc trạng thái:</span>
        <form asp-action="Reviews" method="get" style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <select name="status" class="filter-select" onchange="this.form.submit()">
                <option value="">Tất cả</option>
                <option value="Approved" selected="@(ViewBag.CurrentStatus == "Approved")">Đã duyệt</option>
                <option value="Pending" selected="@(ViewBag.CurrentStatus == "Pending")">Chờ duyệt</option>
                <option value="Rejected" selected="@(ViewBag.CurrentStatus == "Rejected")">Từ chối</option>
            </select>
            <a asp-action="Reviews" class="btn btn-secondary">Xóa lọc</a>
        </form>
    </div>

    <div class="table-container">
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Người dùng</th>
                        <th>Sản phẩm</th>
                        <th>Nội dung</th>
                        <th>Đánh giá</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var review in Model)
                        {
                            <tr>
                                <td>#@review.ReviewID</td>
                                <td><span style="font-weight:600;">@review.User?.UserName</span></td>
                                <td>@review.Product?.ProductName</td>
                                <td>
                                    <div class="text-truncate-cell" title="@review.Content">
                                        <strong>@review.Title</strong> - @review.Content
                                    </div>
                                </td>
                                <td style="color: #fbbf24;">
                                    @for (int i = 0; i < review.Rating; i++)
                                    {
                                        <span>★</span>
                                    }
                                </td>
                                <td>
                                    @if (review.Status == "Approved")
                                    {
                                        <span class="badge badge-success">Đã duyệt</span>
                                    }
                                    else if (review.Status == "Pending")
                                    {

                                        <span class="badge badge-warning">Chờ duyệt</span>
                                    }
                                    else
                                    {

                                        <span class="badge badge-danger">Từ chối</span>
                                    }
                                </td>
                                <td>@review.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div style="display: flex; gap: 0.5rem;">
                                        <a href="@Url.Action("Details", "Review", new { area = "Admin", id = review.ReviewID })" class="btn btn-blue" title="Kiểm duyệt"><i class="fa-solid fa-eye"></i></a>
                                        <form asp-action="DeleteReview" method="post" class="inline-form" onsubmit="return confirm('Chắc chắn muốn xóa?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@review.ReviewID" />
                                            <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="empty-state">
                                <i class="fa-solid fa-inbox empty-state-icon"></i>
                                <div class="empty-state-text">Không có review nào</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>