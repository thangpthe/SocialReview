@model IEnumerable<SocialReview.Models.Product>
@{
    ViewData["Title"] = $"Tìm kiếm: {ViewData["SearchQuery"]}";
    ViewData["Description"] = $"Kết quả tìm kiếm cho \"{ViewData["SearchQuery"]}\" trên Trustify.";
    Layout = "_Layout";
    var query = ViewData["SearchQuery"]?.ToString() ?? "";
    var count = Model?.Count() ?? 0;
}

@section Styles {
    <style>
        /* ── SEARCH RESULTS PAGE ─────────────────────────────────── */
        :root {
            --pp: #7c3aed;
            --pp-d: #6d28d9;
            --pp-l: #ede9fe;
        }

        .search-page {
            max-width: 1280px;
            margin: 0 auto;
            padding: 2rem 1.25rem 4rem;
        }

        /* ── SEARCH HEADER ───────────────────────────────────────── */
        .search-header {
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 2px solid #f1f5f9;
        }

        .search-breadcrumb {
            display: flex;
            align-items: center;
            gap: .5rem;
            font-size: .8rem;
            color: #94a3b8;
            margin-bottom: .75rem;
            flex-wrap: wrap;
        }

            .search-breadcrumb a {
                color: var(--pp);
                font-weight: 500;
            }

                .search-breadcrumb a:hover {
                    text-decoration: underline;
                }

            .search-breadcrumb i {
                font-size: .65rem;
            }

        .search-title-row {
            display: flex;
            align-items: baseline;
            flex-wrap: wrap;
            gap: .75rem;
        }

        .search-title {
            font-size: 1.5rem;
            font-weight: 800;
            color: #0f172a;
            margin: 0;
        }

        .search-keyword {
            color: var(--pp);
            background: var(--pp-l);
            padding: .15rem .6rem;
            border-radius: 6px;
            font-size: 1.35rem;
        }

        .search-count-badge {
            font-size: .85rem;
            color: #64748b;
            background: #f1f5f9;
            padding: .2rem .7rem;
            border-radius: 50px;
            font-weight: 600;
        }

        /* ── QUICK SEARCH BAR ────────────────────────────────────── */
        .search-refine-form {
            display: flex;
            gap: .6rem;
            margin-top: 1.25rem;
            max-width: 560px;
        }

        .search-refine-input {
            flex: 1;
            border: 1.5px solid #e2e8f0;
            border-radius: 50px;
            padding: .6rem 1.1rem;
            font-size: .9rem;
            outline: none;
            transition: border-color .2s, box-shadow .2s;
            font-family: inherit;
            color: #0f172a;
        }

            .search-refine-input:focus {
                border-color: var(--pp);
                box-shadow: 0 0 0 3px var(--pp-l);
            }

        .search-refine-btn {
            background: var(--pp);
            color: #fff;
            border: none;
            border-radius: 50px;
            padding: .6rem 1.35rem;
            font-weight: 700;
            font-size: .875rem;
            cursor: pointer;
            transition: background .2s;
            white-space: nowrap;
        }

            .search-refine-btn:hover {
                background: var(--pp-d);
            }

        /* ── PRODUCT GRID ────────────────────────────────────────── */
        .search-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
            gap: 1.35rem;
        }

        .product-card {
            background: #fff;
            border-radius: 14px;
            overflow: hidden;
            border: 1px solid #f1f5f9;
            box-shadow: 0 2px 8px rgba(0,0,0,.05);
            transition: transform .25s ease, box-shadow .25s ease, border-color .25s;
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
        }

            .product-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 28px rgba(124,58,237,.12);
                border-color: #ddd6fe;
            }

        .product-card-img {
            position: relative;
            overflow: hidden;
            background: var(--pp-l);
        }

            .product-card-img img {
                width: 100%;
                height: 195px;
                object-fit: cover;
                display: block;
                transition: transform .4s ease;
            }

        .product-card:hover .product-card-img img {
            transform: scale(1.04);
        }

        .product-card-img-placeholder {
            height: 195px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #c4b5fd;
            font-size: 2.5rem;
        }

        .product-card-body {
            padding: 1.15rem;
            display: flex;
            flex-direction: column;
            flex: 1;
            gap: .35rem;
        }

        .product-type-chip {
            display: inline-block;
            background: var(--pp-l);
            color: var(--pp);
            font-size: .7rem;
            font-weight: 700;
            padding: .18rem .65rem;
            border-radius: 50px;
            width: fit-content;
            letter-spacing: .3px;
        }

        .product-card-name {
            font-size: 1rem;
            font-weight: 700;
            color: #0f172a;
            margin: 0;
            line-height: 1.4;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .product-card-desc {
            font-size: .82rem;
            color: #64748b;
            line-height: 1.5;
            margin: 0;
            flex: 1;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .product-card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: .75rem;
            border-top: 1px solid #f8fafc;
            margin-top: .25rem;
            gap: .5rem;
        }

        .product-card-company {
            display: flex;
            align-items: center;
            gap: .35rem;
            font-size: .78rem;
            color: #94a3b8;
            min-width: 0;
        }

            .product-card-company span {
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

        .product-card-rating {
            display: flex;
            align-items: center;
            gap: .3rem;
            font-size: .78rem;
            color: #f59e0b;
            flex-shrink: 0;
            white-space: nowrap;
        }

            .product-card-rating span {
                color: #64748b;
            }

        .product-price-tag {
            font-size: .85rem;
            font-weight: 700;
            color: var(--pp);
            flex-shrink: 0;
        }

        /* ── EMPTY STATE ─────────────────────────────────────────── */
        .search-empty {
            background: #fff;
            border-radius: 16px;
            padding: 5rem 2rem;
            text-align: center;
            border: 2px dashed #e2e8f0;
        }

            .search-empty i {
                font-size: 3.5rem;
                color: #cbd5e1;
                display: block;
                margin-bottom: 1.25rem;
            }

            .search-empty h3 {
                font-size: 1.35rem;
                color: #374151;
                margin-bottom: .4rem;
            }

            .search-empty p {
                color: #94a3b8;
                margin-bottom: 1.5rem;
            }

        .btn-back-home {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            background: var(--pp);
            color: #fff;
            border-radius: 50px;
            padding: .75rem 1.75rem;
            font-weight: 700;
            transition: background .2s;
        }

            .btn-back-home:hover {
                background: var(--pp-d);
                color: #fff;
            }

        /* ── RELATED SEARCHES ────────────────────────────────────── */
        .related-section {
            margin-top: 2rem;
        }

        .related-title {
            font-size: 1rem;
            font-weight: 600;
            color: #374151;
            margin-bottom: .75rem;
        }

        .related-tags {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem;
        }

        .related-tag {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 50px;
            padding: .3rem .9rem;
            font-size: .8rem;
            color: #475569;
            text-decoration: none;
            transition: background .2s, border-color .2s, color .2s;
        }

            .related-tag:hover {
                background: var(--pp-l);
                border-color: var(--pp);
                color: var(--pp);
            }

        /* ── RESPONSIVE ──────────────────────────────────────────── */
        @@media (max-width: 768px) {
            .search-grid {
                grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
                gap: 1rem;
            }

            .search-title {
                font-size: 1.25rem;
            }

            .search-refine-form {
                max-width: 100%;
            }
        }

        @@media (max-width: 480px) {
            .search-grid {
                grid-template-columns: 1fr;
            }

            .search-page {
                padding: 1.25rem 1rem 3rem;
            }
        }
    </style>
}

<div class="search-page">

   
    <div class="search-header">
        {{-- Breadcrumb --}}
        <nav class="search-breadcrumb" aria-label="Breadcrumb">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
            <span>Tìm kiếm</span>
            @if (!string.IsNullOrEmpty(query))
            {
                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                <span>@query</span>
            }
        </nav>

        <div class="search-title-row">
            <h1 class="search-title">
                Kết quả cho
                @if (!string.IsNullOrEmpty(query))
                {
                    <span class="search-keyword">"@query"</span>
                }
            </h1>
            <span class="search-count-badge">@count sản phẩm</span>
        </div>

        <form class="search-refine-form" asp-controller="Search" asp-action="Index" method="get"
              role="search" aria-label="Tìm kiếm lại">
            <input class="search-refine-input" type="search" name="query"
                   value="@query" placeholder="Tìm kiếm khác...">
            <button class="search-refine-btn" type="submit">
                <i class="fa-solid fa-magnifying-glass"></i> Tìm
            </button>
        </form>
    </div>


    @if (Model != null && Model.Any())
    {
        <div class="search-grid" role="list" aria-label="Kết quả tìm kiếm">
            @foreach (var product in Model)
            {
                var avgRating = (product.Reviews != null && product.Reviews.Any())
                ? product.Reviews.Average(r => r.Rating)
                : 0.0;
                var reviewCount = product.Reviews?.Count ?? 0;

                <a href="/Product/Detail/@product.ProductID"
                   class="product-card"
                   role="listitem"
                   aria-label="@product.ProductName">
                    <div class="product-card-img">
                        @if (!string.IsNullOrEmpty(product.ProductImage))
                        {
                            <img src="@product.ProductImage" alt="@product.ProductName" loading="lazy">
                        }
                        else
                        {
                            <div class="product-card-img-placeholder" aria-hidden="true">
                                <i class="fa-solid fa-box"></i>
                            </div>
                        }
                    </div>
                    <div class="product-card-body">
                        @if (!string.IsNullOrEmpty(product.ProductType))
                        {
                            <span class="product-type-chip">@product.ProductType</span>
                        }
                        <h3 class="product-card-name">@product.ProductName</h3>
                        @if (!string.IsNullOrEmpty(product.ProductDescription))
                        {
                            <p class="product-card-desc">@product.ProductDescription</p>
                        }
                        <div class="product-card-footer">
                            @if (product.Company != null)
                            {
                                <div class="product-card-company">
                                    <i class="fa-solid fa-building" aria-hidden="true"></i>
                                    <span>@product.Company.CompanyName</span>
                                </div>
                            }
                            else
                            {

                                <div></div>
                            }

                            @if (reviewCount > 0)
                            {
                                <div class="product-card-rating" aria-label="@avgRating.ToString("F1") sao">
                                    <i class="fa-solid fa-star" aria-hidden="true"></i>
                                    <span>@avgRating.ToString("F1")</span>
                                    <span>(@reviewCount)</span>
                                </div>
                            }
                            else if (product.ProductPrice > 0)
                            {
                                <span class="product-price-tag">@product.ProductPrice.ToString("N0") ₫</span>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>

        <div class="related-section">
            <p class="related-title">Tìm kiếm liên quan:</p>
            <div class="related-tags">
                <a asp-controller="Product" asp-action="Index" class="related-tag">Tất cả sản phẩm</a>
                <a asp-controller="Product" asp-action="Index" asp-route-CurrentType="Dịch vụ" class="related-tag">Dịch vụ</a>
                <a asp-controller="Product" asp-action="Index" asp-route-CurrentType="Sản phẩm" class="related-tag">Sản phẩm</a>
                <a asp-controller="Company" asp-action="Index" class="related-tag">Doanh nghiệp</a>
            </div>
        </div>
    }
    else
    {
        <div class="search-empty" role="status">
            <i class="fa-solid fa-magnifying-glass-minus" aria-hidden="true"></i>
            <h3>Không tìm thấy kết quả</h3>
            <p>
                Không có sản phẩm nào khớp với
                @if (!string.IsNullOrEmpty(query))
                {
                    <strong>"@query"</strong>
                }
                . Hãy thử từ khóa khác.
            </p>
            <div style="display:flex; gap:.75rem; justify-content:center; flex-wrap:wrap;">
                <a asp-controller="Product" asp-action="Index" class="btn-back-home">
                    <i class="fa-solid fa-box"></i> Xem tất cả sản phẩm
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn-back-home"
                   style="background:#f1f5f9; color:#374151;">
                    <i class="fa-solid fa-house"></i> Về trang chủ
                </a>
            </div>
        </div>
    }

</div>
