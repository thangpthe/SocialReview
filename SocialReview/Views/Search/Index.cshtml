@model IEnumerable<SocialReview.Models.Product>
@{
    ViewData["Title"] = "Kết quả tìm kiếm - Trustify";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/product-search.css" asp-append-version="true" />
}

<div class="search-container">
    <div class="search-header">
        <h2 class="search-title">Kết quả tìm kiếm <span class="search-count">(@(Model?.Count() ?? 0) sản phẩm)</span></h2>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="product-grid">
            @foreach (var product in Model)
            {
                <a href="/Product/Detail/@product.ProductID" class="product-card">
                    @if (!string.IsNullOrEmpty(product.ProductImage))
                    {
                        <img src="@product.ProductImage" alt="@product.ProductName" class="product-image">
                    }
                    else
                    {
                        <div class="product-image" style="display:flex; align-items:center; justify-content:center; color:#9ca3af;">
                            <i class="fa-solid fa-image fa-3x"></i>
                        </div>
                    }

                    <div class="card-body">
                        <h4 class="product-name">@product.ProductName</h4>
                        <p class="product-company"><i class="fa-solid fa-building"></i> @(product.Company?.CompanyName ?? "Đang cập nhật")</p>

                        <div class="product-rating">
                            <span style="color: #fbbf24;">★★★★☆</span> (@(product.Reviews?.Count ?? 0) đánh giá)
                        </div>

                        <p class="product-price">@(product.ProductPrice > 0 ? product.ProductPrice.ToString("N0") + " ₫" : "Liên hệ")</p>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div style="text-align: center; padding: 4rem 2rem; background: white; border-radius: 12px; border: 1px solid #f3f4f6;">
            <i class="fa-solid fa-box-open" style="font-size: 3rem; color: #d1d5db; margin-bottom: 1rem;"></i>
            <h3 style="font-size: 1.25rem; color: #374151; margin-bottom: 0.5rem;">Không tìm thấy sản phẩm</h3>
            <p style="color: #6b7280; margin-bottom: 1.5rem;">Vui lòng thử tìm kiếm với từ khóa khác.</p>
            <a href="/" style="display: inline-block; background: #7c3aed; color: white; padding: 10px 24px; border-radius: 50px; text-decoration: none; font-weight: 600;">Quay lại trang chủ</a>
        </div>
    }
</div>