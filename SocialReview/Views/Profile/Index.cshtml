@model SocialReview.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = $"Hồ sơ cá nhân — {Model.FullName ?? Model.Username}";
    ViewData["Description"] = $"Trang hồ sơ của {Model.FullName ?? Model.Username} trên Trustify.";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/user-profile.css" asp-append-version="true" />
    <style>
        /* ── PROFILE PAGE FIXES ──────────────────────────────────────
           Responsive overrides & UI improvements on top of user-profile.css
           ──────────────────────────────────────────────────────────── */
        :root {
            --pp: #7c3aed;
            --pp-d: #6d28d9;
            --pp-l: #ede9fe;
            --yellow: #f59e0b;
        }

        .profile-page {
            max-width: 1100px;
            margin: 0 auto;
            padding: 2rem 1.25rem 4rem;
        }

        /* ── ALERTS ──────────────────────────────────────────────── */
        .alert-box {
            display: flex;
            align-items: center;
            gap: .65rem;
            padding: .85rem 1.1rem;
            border-radius: 10px;
            margin-bottom: 1.25rem;
            font-size: .9rem;
            font-weight: 500;
        }

            .alert-box.success {
                background: #d1fae5;
                color: #065f46;
                border-left: 4px solid #10b981;
            }

            .alert-box.error {
                background: #fee2e2;
                color: #991b1b;
                border-left: 4px solid #ef4444;
            }

        /* ── PROFILE HEADER CARD ─────────────────────────────────── */
        .profile-header-card {
            background: #fff;
            border-radius: 18px;
            padding: 2rem;
            display: flex;
            align-items: flex-start;
            gap: 1.75rem;
            box-shadow: 0 4px 18px rgba(0,0,0,.06);
            border: 1px solid #f3f4f6;
            margin-bottom: 2.5rem;
            flex-wrap: wrap;
        }

        /* Avatar */
        .profile-avatar-wrap {
            flex-shrink: 0;
        }

            .profile-avatar-wrap .avatar {
                width: 96px;
                height: 96px;
                border-radius: 50%;
                border: 3px solid var(--pp-l);
                object-fit: cover;
                display: block;
            }

            .profile-avatar-wrap .avatar-icon-wrapper {
                width: 96px;
                height: 96px;
                border-radius: 50%;
                border: 3px solid var(--pp-l);
                background: var(--pp-l);
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--pp);
                font-size: 2.5rem;
            }

        /* Info block */
        .profile-info-block {
            flex: 1;
            min-width: 0;
        }

            .profile-info-block h1 {
                font-size: 1.6rem;
                font-weight: 800;
                color: #111827;
                margin: 0 0 .3rem;
                line-height: 1.2;
            }

        .profile-meta {
            color: #6b7280;
            font-size: .875rem;
            display: flex;
            flex-wrap: wrap;
            gap: .4rem .9rem;
            margin-bottom: .6rem;
        }

            .profile-meta i {
                color: var(--pp);
            }

        .member-since {
            font-size: .8rem;
            color: #9ca3af;
            margin-bottom: 1rem;
        }

        .profile-stats-row {
            display: flex;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

        .stat-pill {
            text-align: center;
            background: var(--pp-l);
            border-radius: 10px;
            padding: .5rem 1.1rem;
        }

            .stat-pill .value {
                font-size: 1.35rem;
                font-weight: 800;
                color: var(--pp);
                line-height: 1;
            }

            .stat-pill .label {
                font-size: .72rem;
                color: #6b7280;
                margin-top: .2rem;
            }

        /* Edit button */
        .profile-action-btn {
            background: var(--pp);
            color: #fff;
            border: none;
            border-radius: 50px;
            padding: .65rem 1.5rem;
            font-weight: 700;
            font-size: .875rem;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            transition: background .2s, transform .2s;
            flex-shrink: 0;
        }

            .profile-action-btn:hover {
                background: var(--pp-d);
                transform: translateY(-2px);
            }

        /* ── SECTION HEADER ──────────────────────────────────────── */
        .reviews-section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

            .reviews-section-header h2 {
                font-size: 1.35rem;
                font-weight: 800;
                color: #111827;
                margin: 0;
            }

        .btn-new-review {
            background: var(--pp);
            color: #fff;
            border-radius: 50px;
            padding: .6rem 1.35rem;
            font-weight: 700;
            font-size: .875rem;
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            text-decoration: none;
            transition: background .2s;
        }

            .btn-new-review:hover {
                background: var(--pp-d);
                color: #fff;
            }

        /* ── REVIEW GRID ─────────────────────────────────────────── */
        .my-review-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 1.25rem;
        }

        /* ── REVIEW CARD ─────────────────────────────────────────── */
        .my-review-card {
            background: #fff;
            border-radius: 14px;
            overflow: hidden;
            border: 1px solid #f3f4f6;
            box-shadow: 0 2px 8px rgba(0,0,0,.05);
            transition: transform .25s, box-shadow .25s;
            display: flex;
            flex-direction: column;
        }

            .my-review-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 10px 24px rgba(124,58,237,.1);
            }

        .my-review-img {
            width: 100%;
            height: 175px;
            object-fit: cover;
            background: var(--pp-l);
            display: block;
        }

        .my-review-img-placeholder {
            height: 175px;
            background: var(--pp-l);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #c4b5fd;
            font-size: 2.5rem;
        }

        .my-review-body {
            padding: 1.1rem;
            display: flex;
            flex-direction: column;
            flex: 1;
            gap: .5rem;
        }

        .my-review-stars {
            color: var(--yellow);
            font-size: .85rem;
        }

            .my-review-stars i.empty {
                color: #e5e7eb;
            }

        .my-review-title-link {
            text-decoration: none;
        }

            .my-review-title-link h3 {
                font-size: 1rem;
                font-weight: 700;
                color: #111827;
                margin: 0;
                line-height: 1.35;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

            .my-review-title-link:hover h3 {
                color: var(--pp);
            }

        .my-review-product {
            font-size: .8rem;
            color: #9ca3af;
            margin: 0;
        }

            .my-review-product strong {
                color: #6b7280;
            }

        .my-review-excerpt {
            font-size: .83rem;
            color: #6b7280;
            line-height: 1.5;
            margin: 0;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
            flex: 1;
        }

        .my-review-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: .5rem;
            margin-top: .5rem;
        }

        .btn-edit-review, .btn-delete-review {
            border-radius: 8px;
            padding: .5rem .75rem;
            font-size: .8rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .35rem;
            cursor: pointer;
            transition: opacity .2s;
            border: none;
            text-decoration: none;
            text-align: center;
        }

        .btn-edit-review {
            background: var(--pp-l);
            color: var(--pp);
        }

            .btn-edit-review:hover {
                color: var(--pp-d);
                opacity: .85;
            }

        .btn-delete-review {
            background: #fee2e2;
            color: #b91c1c;
        }

            .btn-delete-review:hover {
                opacity: .85;
            }

        /* ── EMPTY STATE ─────────────────────────────────────────── */
        .empty-reviews {
            background: #fff;
            border: 2px dashed #ddd6fe;
            border-radius: 16px;
            padding: 4rem 2rem;
            text-align: center;
        }

            .empty-reviews i {
                font-size: 3rem;
                color: #c4b5fd;
                margin-bottom: 1rem;
            }

            .empty-reviews h3 {
                font-size: 1.15rem;
                color: #374151;
                margin-bottom: .4rem;
            }

            .empty-reviews p {
                color: #9ca3af;
                margin-bottom: 1.5rem;
            }

        .btn-explore {
            background: var(--pp);
            color: #fff;
            border-radius: 50px;
            padding: .75rem 2rem;
            font-weight: 700;
            text-decoration: none;
            display: inline-block;
        }

            .btn-explore:hover {
                background: var(--pp-d);
                color: #fff;
            }

        /* ── RESPONSIVE ──────────────────────────────────────────── */
        @@media (max-width: 768px) {
            .profile-header-card {
                flex-direction: column;
                align-items: center;
                text-align: center;
            }

            .profile-info-block h1 {
                font-size: 1.35rem;
            }

            .profile-meta {
                justify-content: center;
            }

            .profile-stats-row {
                justify-content: center;
            }

            .profile-action-btn {
                width: 100%;
                justify-content: center;
            }

            .reviews-section-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .btn-new-review {
                width: 100%;
                justify-content: center;
            }
        }

        @@media (max-width: 480px) {
            .my-review-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="profile-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-box success" role="alert">
            <i class="fa-solid fa-check-circle" aria-hidden="true"></i>
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-box error" role="alert">
            <i class="fa-solid fa-exclamation-circle" aria-hidden="true"></i>
            @TempData["ErrorMessage"]
        </div>
    }

    <section class="profile-header-card" aria-label="Thông tin hồ sơ">
        <div class="profile-avatar-wrap">
            @if (!string.IsNullOrEmpty(Model.UserAvatar))
            {
                <img src="@Model.UserAvatar" alt="Avatar của @(Model.FullName ?? Model.Username)"
                     class="avatar" loading="lazy">
            }
            else
            {
                <div class="avatar-icon-wrapper" aria-hidden="true">
                    <i class="fa-solid fa-user"></i>
                </div>
            }
        </div>

        <div class="profile-info-block">
            <h1>@(string.IsNullOrEmpty(Model.FullName) ? Model.Username : Model.FullName)</h1>
            <div class="profile-meta">
                <span><i class="fa-solid fa-at" aria-hidden="true"></i> @Model.Username</span>
                <span><i class="fa-regular fa-envelope" aria-hidden="true"></i> @Model.Email</span>
            </div>
            <p class="member-since">
                <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                Tham gia từ @Model.CreatedAt.ToString("dd/MM/yyyy")
            </p>
            <div class="profile-stats-row">
                <div class="stat-pill">
                    <div class="value">@(Model.MyReviews?.Count ?? 0)</div>
                    <div class="label">Review đã viết</div>
                </div>
                <div class="stat-pill">
                    <div class="value">@(Model.MyReviews?.Sum(r => r.Reactions?.Count ?? 0) ?? 0)</div>
                    <div class="label">Lượt tương tác</div>
                </div>
            </div>
        </div>

        <div>
            <button id="btn-open-edit-modal" class="profile-action-btn"
                    aria-label="Chỉnh sửa hồ sơ">
                <i class="fa-solid fa-pen" aria-hidden="true"></i>
                Sửa hồ sơ
            </button>
        </div>
    </section>

    <section aria-label="Danh sách review của tôi">
        <div class="reviews-section-header">
            <h2>Review của tôi (@(Model.MyReviews?.Count ?? 0))</h2>
            <a asp-controller="Product" asp-action="Index" class="btn-new-review">
                <i class="fa-solid fa-plus" aria-hidden="true"></i> Viết review mới
            </a>
        </div>

        @if (Model.MyReviews != null && Model.MyReviews.Any())
        {
            <div class="my-review-grid">
                @foreach (var review in Model.MyReviews.OrderByDescending(r => r.CreatedAt))
                {
                    <article class="my-review-card">
                        @if (!string.IsNullOrEmpty(review.Image))
                        {
                            <img src="@review.Image" alt="@review.Title" class="my-review-img" loading="lazy">
                        }
                        else if (review.Product != null && !string.IsNullOrEmpty(review.Product.ProductImage))
                        {
                            <img src="@review.Product.ProductImage" alt="@(review.Product.ProductName)"
                                 class="my-review-img" loading="lazy">
                        }
                        else
                        {
                            <div class="my-review-img-placeholder" aria-hidden="true">
                                <i class="fa-solid fa-image"></i>
                            </div>
                        }

                        <div class="my-review-body">
                            <div class="my-review-stars" aria-label="@review.Rating sao">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="@(i <= review.Rating ? "fas fa-star" : "far fa-star empty")"
                                       aria-hidden="true"></i>
                                }
                                <span style="font-size:.8rem; color:#6b7280; margin-left:.3rem;">@review.Rating/5</span>
                            </div>

                            <a href="@Url.Action("Detail", "Product", new { id = review.ProductID })"
                               class="my-review-title-link">
                                <h3>@review.Title</h3>
                            </a>

                            <p class="my-review-product">
                                Về: <strong>@(review.Product?.ProductName ?? "Sản phẩm")</strong>
                            </p>

                            @if (!string.IsNullOrEmpty(review.Content))
                            {
                                <p class="my-review-excerpt">@review.Content</p>
                            }

                            <div class="my-review-actions">
                                <a asp-action="EditReview" asp-controller="Profile"
                                   asp-route-id="@review.ReviewID"
                                   class="btn-edit-review" aria-label="Chỉnh sửa review">
                                    <i class="fas fa-edit" aria-hidden="true"></i> Sửa
                                </a>
                                <form asp-action="DeleteReview" asp-controller="Profile"
                                      asp-route-id="@review.ReviewID"
                                      method="post" style="display:contents;"
                                      onsubmit="return confirm('Bạn chắc chắn muốn xóa review này?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-delete-review"
                                            aria-label="Xóa review">
                                        <i class="fas fa-trash" aria-hidden="true"></i> Xóa
                                    </button>
                                </form>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="empty-reviews" role="status">
                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                <h3>Bạn chưa có review nào</h3>
                <p>Hãy chia sẻ trải nghiệm của bạn với cộng đồng ngay hôm nay.</p>
                <a asp-controller="Product" asp-action="Index" class="btn-explore">
                    Khám phá sản phẩm
                </a>
            </div>
        }
    </section>
</div>

<div id="modal-placeholder"></div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modalPlaceholder = document.getElementById('modal-placeholder');
            const openModalBtn = document.getElementById('btn-open-edit-modal');

            if (openModalBtn) {
                openModalBtn.addEventListener('click', function () {
                    fetch('@Url.Action("EditProfile", "Profile")')
                        .then(r => r.text())
                        .then(html => { modalPlaceholder.innerHTML = html; })
                        .catch(() => alert('Không thể tải form chỉnh sửa'));
                });
            }

            modalPlaceholder.addEventListener('click', function (e) {
                if (e.target.id === 'btn-close-modal' ||
                    e.target.id === 'btn-cancel-modal' ||
                    e.target.id === 'edit-profile-modal') {
                    modalPlaceholder.innerHTML = '';
                }
            });
        });
    </script>
}
