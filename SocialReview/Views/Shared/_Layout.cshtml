                }

        .footer-bottom {
            flex-direction: column;
            text-align: center;
        }

        }
    </style>
</head>
<body>
    <header class="main-header" role="banner">
        <div class="header-container">
            <a asp-controller="Home" asp-action="Index" class="logo" aria-label="Trustify - Trang chủ">
                <i class="fa-solid fa-shield-check" aria-hidden="true"></i> Trustify
            </a>

            <div class="header-nav-wrapper" id="navWrapper">
                <nav class="nav-menu" aria-label="Menu chính">
                    <a asp-controller="Home" asp-action="Index" class="nav-link">Trang chủ</a>
                    <a asp-controller="Product" asp-action="Index" class="nav-link">Sản phẩm</a>
                    <a asp-controller="Company" asp-action="Index" class="nav-link">Doanh nghiệp</a>
                </nav>

                <form class="header-search" asp-controller="Search" asp-action="Index" method="get" role="search">
                    <input type="search" name="query" placeholder="Tìm kiếm sản phẩm..." required>
                    <button type="submit" aria-label="Tìm kiếm">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </form>
            </div>

            <div class="header-actions-right">
                <div class="auth-buttons">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Profile" asp-action="Index" class="nav-link" style="color: var(--primary);">
                            <i class="fa-solid fa-circle-user"></i> <span class="hide-on-mobile">@User.Identity.Name</span>
                        </a>
                        <form asp-controller="Auth" asp-action="Logout" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-register" aria-label="Đăng xuất">
                                <i class="fa-solid fa-right-from-bracket show-on-mobile"></i>
                                <span class="hide-on-mobile">Đăng xuất</span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" class="btn-login" aria-label="Đăng nhập">
                            <i class="fa-solid fa-arrow-right-to-bracket show-on-mobile"></i>
                            <span class="hide-on-mobile">Đăng nhập</span>
                        </a>
                        <a asp-controller="Auth" asp-action="Register" class="btn-register">Đăng ký</a>
                    }
                </div>

                <button class="mobile-toggle" id="mobileMenuBtn" aria-label="Mở menu" aria-expanded="false">
                    <i class="fa-solid fa-bars" id="menuIcon" aria-hidden="true"></i>
                </button>
            </div>

        </div>
    </header>

    <main role="main" class="main-content">
        @RenderBody()
    </main>

    <footer class="main-footer" role="contentinfo">
        <div class="footer-container">
            <div class="footer-col">
                <div class="footer-brand">
                    <i class="fa-solid fa-shield-check" aria-hidden="true"></i> Trustify
                </div>
                <p class="footer-desc">
                    Nền tảng đánh giá độc lập và minh bạch hàng đầu Việt Nam. Chúng tôi kết nối người tiêu dùng với những sản phẩm và dịch vụ uy tín nhất thông qua sức mạnh của cộng đồng.
                </p>
                <div class="social-links" aria-label="Mạng xã hội">
                    <a href="#"><i class="fa-brands fa-facebook-f" aria-hidden="true"></i></a>
                    <a href="#"><i class="fa-brands fa-tiktok" aria-hidden="true"></i></a>
                    <a href="#"><i class="fa-brands fa-youtube" aria-hidden="true"></i></a>
                    <a href="#"><i class="fa-brands fa-linkedin-in" aria-hidden="true"></i></a>
                </div>
            </div>

            <div class="footer-col">
                <h3>Khám phá</h3>
                <ul class="footer-links">
                    <li><a asp-controller="Product" asp-action="Index">Tất cả sản phẩm</a></li>
                    <li><a asp-controller="Company" asp-action="Index">Top doanh nghiệp</a></li>
                    <li><a href="#">Reviews mới nhất</a></li>
                    <li><a href="#">Bảng xếp hạng</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h3>Doanh nghiệp</h3>
                <ul class="footer-links">
                    <li><a href="#">Đăng ký đối tác</a></li>
                    <li><a href="#">Xác thực tài khoản</a></li>
                    <li><a href="#">Quy định khiếu nại</a></li>
                    <li><a href="#">Bảng giá dịch vụ</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h3>Hỗ trợ</h3>
                <ul class="contact-info" aria-label="Thông tin liên hệ">
                    <li>
                        <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                        <span>Công viên phần mềm Quang Trung, Quận 12, TP.HCM</span>
                    </li>
                    <li>
                        <i class="fa-solid fa-phone" aria-hidden="true"></i>
                        <span>Hotline: 1900 9999 (8h–18h)</span>
                    </li>
                    <li>
                        <i class="fa-solid fa-envelope" aria-hidden="true"></i>
                        <span>support@trustify.vn</span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; @DateTime.Now.Year Trustify. All rights reserved.</p>
            <nav class="footer-bottom-links" aria-label="Liên kết pháp lý">
                <a href="#">Điều khoản sử dụng</a>
                <a href="#">Chính sách bảo mật</a>
                <a href="#">Quy chế hoạt động</a>
            </nav>
        </div>
    </footer>

    <script>
        (function () {
            const btn = document.getElementById('mobileMenuBtn');
            const nav = document.getElementById('navWrapper');
            const icon = document.getElementById('menuIcon');
            if (!btn || !nav) return;

            btn.addEventListener('click', function () {
                const isOpen = nav.classList.toggle('active');
                btn.setAttribute('aria-expanded', isOpen);
                icon.className = isOpen ? 'fa-solid fa-xmark' : 'fa-solid fa-bars';
            });

            // Tự đóng menu khi click ra ngoài
            document.addEventListener('click', function (e) {
                if (!btn.contains(e.target) && !nav.contains(e.target)) {
                    nav.classList.remove('active');
                    btn.setAttribute('aria-expanded', 'false');
                    icon.className = 'fa-solid fa-bars';
                }
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>